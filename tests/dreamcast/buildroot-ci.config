# Buildroot defconfig for the minimal sh4 busybox rootfs used by the
# Dreamcast boot-regression CI (mainline_boot_test.py). Verified against
# current Buildroot: BR2_sh4 (SH4 little-endian, matches SH7091) is a
# supported target arch, and musl explicitly lists "default y if BR2_sh".
#
# Usage (BR2_ROOTFS_OVERLAY is passed on the make command line, as an
# absolute path, rather than baked into this file as a relative path — it's
# resolved relative to Buildroot's own cwd, not this repo):
#   make O=output defconfig DEFCONFIG=$(pwd)/tests/dreamcast/buildroot-ci.config
#   make O=output BR2_ROOTFS_OVERLAY=$(pwd)/tests/dreamcast/rootfs-overlay
#   # -> output/images/rootfs.tar
#   mkdir rootfs && tar xf output/images/rootfs.tar -C rootfs
#   genisoimage -l -r -C 0,11702 -o rootfs.iso rootfs
#   # -C 0,11702 matches GDROM_DATA_LBA in hw/sh4/dreamcast.c — without it
#   # isofs's root-inode read lands before the data track and mount fails.

# BR2_sh4 is a sub-choice nested under the top-level "Target Architecture"
# choice's BR2_sh (SuperH) option — both must be set, or BR2_sh4=y is
# silently dropped (arch/Config.in.sh never becomes reachable) and Buildroot
# falls back to its i386 default. Verified the hard way.
BR2_sh=y
BR2_sh4=y

# Internal toolchain, musl libc — small, self-contained, cacheable; keeps
# kernel and userspace on one consistent toolchain (no mixing with a
# separate glibc cross-gcc for the kernel build).
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# CI caching relies on this, not on caching output/{host,build}: Buildroot
# tracks per-package build completion via .stamp_* files under
# output/build/<pkg>/, not by checking whether the final binaries already
# exist — a fresh checkout has no stamps, so it reruns every package's
# configure/build/install steps regardless of what's sitting in output/host.
# ccache is content-hash based, so it doesn't care that the stamps are gone:
# each individual compiler invocation still gets served from cache. Default
# cache dir is $HOME/.buildroot-ccache (CI caches that path).
BR2_CCACHE=y

# BusyBox only — no need for a package selection beyond the default system.
BR2_TARGET_GENERIC_HOSTNAME="dc-ci"
BR2_TARGET_GENERIC_ISSUE="Dreamcast CI"

# Drop the CI boot-check script onto the rootfs (see rootfs-overlay/ —
# etc/init.d/S99dc-ci-check echoes the CI_RESULT: PASS/FAIL marker the test
# harness watches for on serial). Passed via BR2_ROOTFS_OVERLAY on the make
# command line (see usage above), not set here — it must be an absolute path.

# Package the root filesystem as a tarball; the CI workflow extracts it and
# feeds it to genisoimage to produce the GD-ROM ISO9660 image QEMU boots
# from (a bog-standard ISO, no CDI/scramble step needed for -kernel boot).
BR2_TARGET_ROOTFS_TAR=y
# CPIO/initrd not used — we boot via the GD-ROM block device to also
# exercise the gdrom.c/ISO9660 driver path, not just initramfs.
# BR2_TARGET_ROOTFS_CPIO is not set
