# Kconfig fragment for the mainline-kernel Dreamcast boot-regression CI.
#
# arch/sh/configs/dreamcast_defconfig upstream already sets everything the
# board itself needs (SH_DREAMCAST, GDROM, MAPLE, FB_PVR2, 8139TOO,
# SERIAL_SH_SCI console=ttySC1) — verified present in linux-next. This
# fragment only adds what the *CI boot test* needs on top: a filesystem
# driver to mount the GD-ROM ISO9660 rootfs, a root= so it actually mounts,
# and devtmpfs so a minimal busybox init doesn't need udev/mdev.
#
# Usage (from a linux-next checkout):
#   make ARCH=sh CROSS_COMPILE=sh4-buildroot-linux-musl- dreamcast_defconfig
#   ./scripts/kconfig/merge_config.sh -m -O . .config \
#       <this-file>
#   make ARCH=sh CROSS_COMPILE=sh4-buildroot-linux-musl- olddefconfig
#   make ARCH=sh CROSS_COMPILE=sh4-buildroot-linux-musl- -j"$(nproc)" vmlinux

CONFIG_ISO9660_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# dreamcast_defconfig's CONFIG_CMDLINE has no root=; CONFIG_CMDLINE_OVERWRITE
# means this is what actually boots (QEMU doesn't pass -append in the CI
# harness) — GD-ROM ISO9660 rootfs, read-only.
#
# Two console= entries: ttySC1 stays *last* so it remains the preferred
# console (/dev/console — what the harness's serial socket and the rootfs's
# own init script both rely on); tty0 is listed too purely so kernel
# messages also get mirrored to the PVR framebuffer console — otherwise
# nothing is ever drawn there (no boot logo is enabled) and the "PVR
# framebuffer non-blank" check has nothing to see.
CONFIG_CMDLINE_OVERWRITE=y
CONFIG_CMDLINE="console=tty0 console=ttySC1,115200 panic=3 root=/dev/gdrom ro"
